{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "runboard",
  "main": "cloudflare/src/worker.js",
  "compatibility_date": "2026-09-24",
  "workers_dev": true,
  "assets": {
    "directory": "src/runboard/static",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB"
    }
  ],
  "r2_buckets": [
    {
      "binding": "METRICS"
    }
  ]
}
