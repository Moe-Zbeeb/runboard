{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "runboard",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-24",
  "workers_dev": true,
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "runboard",
      "database_id": ""
    }
  ]
}
